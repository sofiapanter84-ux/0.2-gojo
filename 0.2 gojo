-- =================================================================
-- BOTÓN 0.2 FARM (LÓGICA JJS: THE HONORED)
-- =================================================================
local FarmBtn = Instance.new("TextButton")
FarmBtn.Size = UDim2.new(1, -20, 0, 50)
FarmBtn.Position = UDim2.new(0, 10, 0, 65)
FarmBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 200)
FarmBtn.Text = "0.2 FARM (G + R)"
FarmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FarmBtn.TextSize = 16
FarmBtn.Font = Enum.Font.GothamBold
FarmBtn.Parent = MainFrame

local UICornerFarm = Instance.new("UICorner")
UICornerFarm.CornerRadius = UDim.new(0, 8)
UICornerFarm.Parent = FarmBtn

local farming = false

FarmBtn.MouseButton1Click:Connect(function()
    if farming then return end
    farming = true
    FarmBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    FarmBtn.Text = "FARMING ACTIVO..."

    task.spawn(function()
        -- 1. Activar simultáneamente Ulti (G) y Habilidad Especial (R)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)

        task.wait(0.3) -- Esperar a que se despliegue la expansión de dominio / estado

        -- 2. Bucle de teletransporte rápido a todos los jugadores del servidor
        local startTime = tick()
        while tick() - startTime < 4.5 do -- Duración estimada del combo/dominio
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHRP = player.Character.HumanoidRootPart
                        -- Teletransporte directo e instantáneo a la posición del enemigo para aplicar daño en área
                        char.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)
                        task.wait(0.04) -- Velocidad de salto entre jugadores
                    end
                end
            end
            task.wait(0.05)
        end

        farming = false
        FarmBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 200)
        FarmBtn.Text = "0.2 FARM (G + R)"
    end)
end)
