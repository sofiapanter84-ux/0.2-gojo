-- =================================================================
-- LÓGICA DE TELETRANSPORTE Y DAÑO REAL PARA DELTA
-- =================================================================
local farming = false

local function getTargets()
    local targets = {}
    
    -- 1. Buscar jugadores reales (excluyendo al usuario local)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(targets, hrp)
            end
        end
    end
    
    -- 2. Buscar Dummies de entrenamiento integrados en el mapa
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("dummy") or obj.Name:lower():find("target") or obj.Name:lower():find("muñeco")) then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(targets, hrp)
            end
        end
    end
    
    return targets
end

FarmBtn.MouseButton1Click:Connect(function()
    if farming then return end
    farming = true
    FarmBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    FarmBtn.Text = "EJECUTANDO 0.2 CON ATAQUE..."

    task.spawn(function()
        pcall(function()
            -- Forzar activación simultánea limpia de G (Ulti) y R (Especial)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)

        task.wait(0.25) -- Breve margen de despliegue

        -- Bucle mejorado de persecución, teletransporte y daño continuo
        local startTime = tick()
        while tick() - startTime < 5.0 do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrpLocal = char.HumanoidRootPart
                    local targets = getTargets()
                    
                    if #targets > 0 then
                        for _, targetHRP in ipairs(targets) do
                            if targetHRP and targetHRP.Parent then
                                -- Teletransporte exacto al objetivo
                                hrpLocal.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1)
                                
                                -- Activar herramienta equipada para forzar el impacto
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then
                                    pcall(function() tool:Activate() end)
                                end
                                
                                -- Simular clic izquierdo del mouse para forzar el golpe físico del personaje
                                VirtualInputManager:SendMouseButtonEvent(500, 500, 0, true, game, 0)
                                task.wait(0.02)
                                VirtualInputManager:SendMouseButtonEvent(500, 500, 0, false, game, 0)
                                
                                task.wait(0.03)
                            end
                        end
                    end
                end
            end)
            task.wait(0.01)
        end

        farming = false
        FarmBtn.BackgroundColor3 = Color3.fromRGB(90, 30, 200)
        FarmBtn.Text = "ACTIVAR 0.2 FARM (G + R)"
    end)
end)
